# Build outputs and editor / OS noise.
target/
**/target/
.git/
.github/
.idea/
.vscode/
.windsurf/
.DS_Store

# Existing CI / chart artefacts -- already shipped from elsewhere.
charts/
docs/

# Integration tests are not needed for the image build; keep benches so
# cargo-chef can parse package manifests that declare [[bench]] targets.
**/tests/
**/*.bench.rs

# Local-only files
*.log
*.swp
.env
.env.*
